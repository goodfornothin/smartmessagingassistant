# Server
PORT=3000
NODE_ENV=development

# Meta webhook verify token — choose any secret string, then paste the SAME value
# into Meta Developer → your app → Webhooks → Verify token
META_VERIFY_TOKEN=replace_with_your_secure_verify_token

# App Secret from Meta Developer → App settings → Basic (used to validate X-Hub-Signature-256)
META_APP_SECRET=replace_with_your_meta_app_secret

# Optional: Page / Instagram access token (needed later to send replies)
# META_PAGE_ACCESS_TOKEN=replace_with_page_or_instagram_access_token
