# LOCAL ONLY — copy to .env and fill in.
# On Vercel: set these in Project → Settings → Environment Variables.
# Never commit real values. Never put these in GitHub.

PORT=3000
NODE_ENV=development

# Invent any long random string. Paste THE SAME value into Meta Webhooks → Verify token
META_VERIFY_TOKEN=replace_with_your_secure_verify_token

# Meta Developer → your app → App settings → Basic → App Secret
META_APP_SECRET=replace_with_your_meta_app_secret

# Optional later (sending replies): Page / Instagram messaging access token
# META_PAGE_ACCESS_TOKEN=replace_with_page_or_instagram_access_token
