# LOCAL ONLY — copy to .env and fill in.
# On Vercel: Project → Settings → Environment Variables.
# Never commit real values. Never put these in GitHub.

PORT=3000
NODE_ENV=development

# Meta webhook verify token (same string in Meta Webhooks)
META_VERIFY_TOKEN=replace_with_your_secure_verify_token

# Meta App Secret (App settings → Basic)
META_APP_SECRET=replace_with_your_meta_app_secret

# Instagram messaging send + conversations
META_PAGE_ACCESS_TOKEN=replace_with_instagram_or_page_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace_with_ig_business_account_id

# Protect Cursor/Claude assistant commands
ASSISTANT_API_KEY=replace_with_long_random_api_key

# Telegram midday plans + inbound DM alerts
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_group_chat_id

# Vercel Cron auth (optional but recommended)
CRON_SECRET=replace_with_long_random_cron_secret
